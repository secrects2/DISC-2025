rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ⚠️ 開發期間：完全開放（等同原 Supabase anon_full 策略）
    // 正式上線前，請縮小權限範圍！
    match /users/{userId} {
      allow read, write: if true;
    }
    match /records/{recordId} {
      allow read, write: if true;
    }
  }
}
